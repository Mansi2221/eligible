# Copy to .env and fill in. Never commit .env.

# --- DeepSeek (OpenAI-compatible API) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model tiers. Set to whatever the account exposes.
# flash = cheap extraction/formatting; pro = reasoning with thinking mode.
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# --- Postgres (OMOP CDM store) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eligible
POSTGRES_USER=eligible
POSTGRES_PASSWORD=eligible

# --- Pinecone (vector fabric) ---
PINECONE_API_KEY=
PINECONE_INDEX=eligible-criteria

# --- Auth (M4) ---
OIDC_ISSUER=
OIDC_AUDIENCE=
JWT_PUBLIC_KEY=
